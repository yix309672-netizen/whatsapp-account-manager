[Unit]
Description=WhatsApp Account Manager (Web)
Documentation=file:///opt/waam/app/deploy/DEPLOY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Electron 需要 X11，服务器没有桌面，用 xvfb-run 起虚拟显示。
# 注意：不要在这里直接写 xvfb-run -s "..."，Ubuntu 24.04 的 xvfb-run 用未加引号的 $@
# 执行命令，-s 的值会被二次拆词并把命令参数吃掉（tries 也会被重置导致重试全失败）。
# 因此统一走 /usr/share/waam/start.sh 包装脚本（install-server.sh 会生成）。
WorkingDirectory=/opt/waam/app
ExecStart=/usr/share/waam/start.sh
EnvironmentFile=/etc/waam.env
Environment=DISPLAY=:99
Environment=ELECTRON_DISABLE_SECURITY_WARNINGS=1
User=root
Restart=always
RestartSec=5
# 关掉 systemd 自己的 stdout 缓冲问题：日志以文件为准（/var/lib/waam/logs）
StandardOutput=journal
StandardError=journal
LimitNOFILE=65535
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
